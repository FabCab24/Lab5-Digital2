void semaforo(void){ //función de activación de semáforo

    // ROJO
    HAL_GPIO_WritePin(Lroja_GPIO_Port, Lroja_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(Lamarilla_GPIO_Port, Lamarilla_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(Lverde_GPIO_Port, Lverde_Pin, GPIO_PIN_RESET);

    HAL_Delay(1000);

    // AMARILLO
    HAL_GPIO_WritePin(Lroja_GPIO_Port, Lroja_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(Lamarilla_GPIO_Port, Lamarilla_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(Lverde_GPIO_Port, Lverde_Pin, GPIO_PIN_RESET);

    HAL_Delay(1000);

    // VERDE
    HAL_GPIO_WritePin(Lroja_GPIO_Port, Lroja_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(Lamarilla_GPIO_Port, Lamarilla_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(Lverde_GPIO_Port, Lverde_Pin, GPIO_PIN_SET);

    HAL_Delay(1000);

    // Apagar
    HAL_GPIO_WritePin(Lroja_GPIO_Port, Lroja_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(Lamarilla_GPIO_Port, Lamarilla_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(Lverde_GPIO_Port, Lverde_Pin, GPIO_PIN_RESET);

    semaforoOFF = 1; //avisa que se terminó la secuencia
    GameStart = 1; //habilita el indicador de juego iniciado
}

