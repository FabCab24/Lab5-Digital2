void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){

	if (GPIO_Pin == BotonJ1_Pin){
	        if (GameStart == 1){
	            if ((HAL_GetTick() - tiempoAnteriorJ1) > 200){
	                contadorJ1++;

	                if (contadorJ1 >= 4){
	                    contadorJ1 = 4;
	                    GameStart = 0;
	                }

	                tiempoAnteriorJ1 = HAL_GetTick();
	            }
	        }
	    }

	if (GPIO_Pin == BotonJ2_Pin){
		        if (GameStart == 1){
		            if ((HAL_GetTick() - tiempoAnteriorJ2) > 200){
		                contadorJ2++;

		                if (contadorJ2 >= 4){
		                    contadorJ2 = 4;
		                    GameStart = 0;
		                }

		                tiempoAnteriorJ2 = HAL_GetTick();
		            }
		        }
		    }
}

